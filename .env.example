# Copy to .env and fill in. Never commit .env.
CARTESIA_API_KEY=
ANTHROPIC_API_KEY=
# PIN nurses type to unlock the board
STAFF_PIN=
# Database owner token so the server can write patient data.
# Optional on the laptop that ran `spacetime login` as the owner; required on teammates' machines.
STDB_TOKEN=
# Apify token, only needed to re-run server/scripts/fetch_popular_times.py
APIFY_TOKEN=
# Set to 0 on every server except the one running the simulator + Assistant (e.g. when deployed)
BACKGROUND_TASKS=1
